 "phrases": [
  {
   "say": "Goosebumps are your body trying to fluff up fur...",
   "cap": "GOOSEBUMPS ARE | YOUR BODY TRYING | TO FLUFF UP *FUR...*",
   "pause": 0.2
  },
  {
   "say": "you don't have.",
   "cap": "YOU *DON'T HAVE.*",
   "pause": 0.45
  },
  {
   "say": "Wait. Why do I get goosebumps?",
   "cap": "WAIT. WHY DO I | GET *GOOSEBUMPS?*",
   "pause": 0.2
  },
  {
   "say": "When you're cold, tiny muscles at the base of each hair contract.",
   "cap": "WHEN YOU'RE COLD, | TINY *MUSCLES* | AT THE BASE | OF EACH HAIR | CONTRACT.",
   "pause": 0.45
  },
  {
   "say": "They pull each hair upright.",
   "cap": "THEY PULL EACH HAIR | *UPRIGHT.*",
   "pause": 0.2
  },
  {
   "say": "Doctors call it piloerection.",
   "cap": "DOCTORS CALL IT | *PILOERECTION.*",
   "pause": 0.45
  },
  {
   "say": "For animals with thick fur, it helps keep them warm.",
   "cap": "FOR ANIMALS | WITH THICK FUR, | IT HELPS KEEP | THEM *WARM.*",
   "pause": 0.2
  },
  {
   "say": "And a puffed up cat looks bigger to a predator.",
   "cap": "AND A PUFFED UP CAT | LOOKS *BIGGER* | TO A PREDATOR.",
   "pause": 0.45
  },
  {
   "say": "You, however, have too little hair for it to keep you warm.",
   "cap": "YOU, HOWEVER, | HAVE *TOO LITTLE HAIR* | FOR IT TO | KEEP YOU WARM.",
   "pause": 0.2
  },
  {
   "say": "Your body does it anyway.",
   "cap": "YOUR BODY | DOES IT *ANYWAY.*",
   "pause": 0.45
  },
  {
   "say": "It even happens with fear, excitement, or a great song.",
   "cap": "IT EVEN HAPPENS | WITH *FEAR*, *EXCITEMENT*, | OR A *GREAT SONG.*",
   "pause": 0.45
  },
  {
   "say": "And in mice, scientists found the same system helps hair grow back.",
   "cap": "AND IN *MICE*, | SCIENTISTS FOUND | THE SAME SYSTEM | HELPS HAIR *GROW BACK.*",
   "pause": 0.45
  },
  {
   "say": "So next time you get goosebumps,",
   "cap": "SO NEXT TIME | YOU GET *GOOSEBUMPS,*",
   "pause": 0.2
  },
  {
   "say": "your body is asking for fur.",
   "cap": "YOUR BODY IS | ASKING FOR *FUR.*",
   "pause": 0.2
  },
  {
   "say": "Request denied.",
   "cap": "REQUEST *DENIED.*",
   "pause": 0.45
  },
  {
   "say": "Follow,",
   "cap": "*FOLLOW*",
   "pause": 0.15
  },
  {
   "say": "for the stuff school skipped.",
   "cap": "FOR THE STUFF | SCHOOL *SKIPPED.*",
   "pause": 0.5
  }
