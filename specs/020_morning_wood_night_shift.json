  {
   "say": "Each one can last twenty to thirty minutes.",
   "cap": "EACH ONE | CAN LAST | *20 TO 30* MINUTES.",
   "pause": 0.45
  },
  {
   "say": "They happen in REM sleep, the stage where you dream.",
   "cap": "THEY HAPPEN IN | *REM SLEEP,* | THE STAGE | WHERE YOU DREAM.",
   "pause": 0.45
  },
  {
   "say": "But no, it's not the dreams.",
   "cap": "BUT NO, IT'S | *NOT THE DREAMS.*",
   "pause": 0.2
  },
  {
   "say": "In REM, your nervous system flips from fight or flight to rest and digest.",
   "cap": "YOUR NERVOUS SYSTEM | FLIPS FROM | *FIGHT OR FLIGHT* | TO *REST AND DIGEST.*",
   "pause": 0.45
  },
