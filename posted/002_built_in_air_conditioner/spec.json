 "phrases": [
  {
   "say": "Men have a built-in air conditioner.",
   "cap": "MEN HAVE A | BUILT-IN | *AIR CONDITIONER.*",
   "pause": 0.2
  },
  {
   "say": "And it's in their pants.",
   "cap": "AND IT'S IN | THEIR *PANTS.*",
   "pause": 0.45
  },
  {
   "say": "Testicles need to stay about two degrees cooler than the rest of the body.",
   "cap": "TESTICLES NEED | TO STAY ABOUT | *2 DEGREES* *COOLER* | THAN THE REST | OF THE BODY.",
   "pause": 0.2
  },
  {
   "say": "Too warm, and sperm production slows down.",
   "cap": "TOO WARM, AND | SPERM PRODUCTION | *SLOWS DOWN.*",
   "pause": 0.45
  },
  {
   "say": "So the body built an elevator.",
   "cap": "SO THE BODY BUILT | AN *ELEVATOR.*",
   "pause": 0.2
  },
  {
   "say": "Cold? They pull up closer for warmth.",
   "cap": "*COLD?* | THEY PULL *UP* | CLOSER FOR WARMTH.",
   "pause": 0.2
  },
  {
   "say": "Hot? They drop down to cool off.",
   "cap": "*HOT?* | THEY DROP *DOWN* | TO COOL OFF.",
   "pause": 0.45
  },
  {
   "say": "That's why hot tubs, and laptops on your lap,",
   "cap": "THAT'S WHY | HOT *TUBS* | AND *LAPTOPS* | ON YOUR LAP",
   "pause": 0.2
  },
  {
   "say": "can lower sperm count for a while.",
   "cap": "CAN *LOWER* | SPERM COUNT | FOR A WHILE.",
   "pause": 0.45
  },
  {
   "say": "Long story short.",
   "cap": "LONG STORY SHORT.",
   "pause": 0.2
  },
  {
   "say": "Keep the twins chill.",
   "cap": "KEEP THE TWINS | *CHILL.*",
   "pause": 0.45
  },
  {
   "say": "Follow,",
   "cap": "*FOLLOW*",
   "pause": 0.15
